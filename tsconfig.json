{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution":"nodenext",
        "rootDir": ".",
        "outDir": "dist/",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": ["node"],

    },
    "include": ["src/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}